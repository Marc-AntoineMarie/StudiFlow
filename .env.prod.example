# Copier en .env à la racine DU VPS (jamais commité) puis remplir chaque valeur.
# Ne jamais réutiliser les valeurs de dev (.env.example) : ce fichier part vers
# une vraie adresse publique (studiflow.marc-antoinemarie.com).

# --- Base de données ---
# Générer un mot de passe fort sur le serveur : openssl rand -hex 24
POSTGRES_USER=studiflow
POSTGRES_PASSWORD=
POSTGRES_DB=studiflow

# Doit reprendre exactement les 3 valeurs ci-dessus (hôte "db" = nom du service Docker) :
DATABASE_URL=postgresql://studiflow:<POSTGRES_PASSWORD>@db:5432/studiflow?schema=public

# --- Backend ---
PORT=3001
CORS_ORIGINS=https://studiflow.marc-antoinemarie.com

# Générer une clé aléatoire dédiée à la prod (NE PAS reprendre celle du .env de dev) :
# openssl rand -hex 32
JWT_SECRET=

UPLOAD_DIR=./uploads

# --- Compte de démonstration (créé/mis à jour automatiquement au démarrage) ---
SEED_USER_EMAIL=demo@studiflow.fr
SEED_USER_PASSWORD=

# --- Frontend ---
# Doit correspondre au domaine public + au préfixe /api du reverse proxy nginx.
NEXT_PUBLIC_API_URL=https://studiflow.marc-antoinemarie.com/api
