# Copier en .env à la racine puis ajuster.

# --- Base de données ---
# Depuis les conteneurs : hôte = "db", port interne = 5432.
DATABASE_URL="postgresql://cadre:cadre@db:5432/cadre?schema=public"

# --- Backend ---
PORT=3001
CORS_ORIGINS=http://localhost:4000

# --- Auth (utilisé à l'étape Auth) ---
JWT_SECRET="a-remplacer-par-une-cle-aleatoire-de-32-caracteres-min"

# --- Seed du compte unique ---
SEED_USER_EMAIL=demo@cadre.local
SEED_USER_PASSWORD=demo-cadre-2026

# --- Frontend (référence, utilisé côté frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:4001/api
