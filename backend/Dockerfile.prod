# Image de production — code compilé, pas de bind-mount, pas de hot-reload.
# Contrairement à Dockerfile (dev), on ne copie pas seulement node_modules "prod" :
# on garde le node_modules complet de l'étape de build (avec devDependencies, dont
# ts-node) car docker-entrypoint.sh lance `npm run seed` via ts-node même en prod.
# Image un peu plus grosse, beaucoup plus simple/fiable — acceptable à cette échelle.

FROM node:22-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npx prisma generate
RUN npm run build

FROM node:22-alpine
RUN apk add --no-cache openssl poppler-utils ffmpeg
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/tsconfig.json ./tsconfig.json
COPY --from=build /app/docker-entrypoint.sh ./docker-entrypoint.sh
# seed-demo.ts (lancé via ts-node, comme le seed de base) importe directement
# des fichiers source (ex. ../src/storage/storage.service) — il faut donc le
# dossier src/ en plus du compilé, pas seulement dist/.
COPY --from=build /app/src ./src

# Même piège que le volume nommé "uploads" en dev (cf. AGENTS.md §6) : le pré-créer
# avec les bons droits AVANT de passer en "node".
RUN mkdir -p uploads && chown -R node:node /app
USER node

EXPOSE 3001
ENTRYPOINT ["sh", "./docker-entrypoint.sh"]
# nest build (sourceRoot "src" dans nest-cli.json) sort dans dist/src/main.js,
# pas dist/main.js — vérifié en buildant l'image (cf. journal de bord).
CMD ["node", "dist/src/main.js"]
