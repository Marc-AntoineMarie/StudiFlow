{
  "name": "cadre-backend",
  "version": "0.0.1",
  "description": "Cadré — API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
